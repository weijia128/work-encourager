{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "work-encourager",
  "version": "0.2.0",
  "identifier": "com.weijia.workencourager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "上班鼓励器",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": false,
        "transparent": true,
        "width": 380,
        "height": 760,
        "label": "main",
        "resizable": true,
        "minWidth": 320,
        "minHeight": 400,
        "alwaysOnTop": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
